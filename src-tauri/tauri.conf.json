{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tokens",
  "version": "0.1.0",
  "identifier": "com.josep.tokens",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Tokens",
        "width": 900,
        "height": 680,
        "minWidth": 620,
        "minHeight": 420,
        "center": true,
        "theme": "Dark",
        "backgroundColor": "#0a0b0c"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
